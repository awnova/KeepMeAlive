<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KeepMeAlive.Server</AssemblyName>
    <RootNamespace>KeepMeAlive.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="SPTushonka.Common" Version="4.1.6" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.6" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
    <PackageReference Include="SemanticVersioning" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="mod.manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <ServerModDir>$(MSBuildProjectDirectory)\..\Build\KeepMeAlive\SPT_Runtime\user\mods\KeepMeAlive</ServerModDir>
  </PropertyGroup>

  <Target Name="DeployToBuildFolder" AfterTargets="Build">
    <ItemGroup>
      <ServerOutputFiles Include="$(TargetDir)$(AssemblyName).dll" />
      <ServerOutputFiles Include="$(TargetDir)$(AssemblyName).deps.json" />
      <ServerOutputFiles Include="mod.manifest.json" />
    </ItemGroup>
    <MakeDir Directories="$(ServerModDir)" />
    <Copy SourceFiles="@(ServerOutputFiles)" DestinationFolder="$(ServerModDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
